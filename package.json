{
  "name": "dsh-persona",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "为用户和模型设置名称、头像与按模型应用的提示词。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./prompts": "./src/modules/prompts/host.mjs",
    "./persona-api": {
      "types": "./src/core/persona-api.d.ts"
    }
  },
  "files": [
    "lib",
    "src",
    "assets/brand",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "docs/*.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-preview.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "prepare": "node scripts/build-preview.mjs",
    "prepack": "node scripts/build-preview.mjs",
    "test": "node scripts/build-preview.mjs && node --test tests/*.test.mjs",
    "preview": "node scripts/build-preview.mjs && node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.1.6-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
